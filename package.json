{
  "name": "warden-anchor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Anchor Warden decision logs on Monad so rewrites and truncation are detectable offline.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@stlw/warden": "0.2.8",
    "@stlw/warden-cli": "^0.2.8",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^26.6.5",
    "hardhat": "^3.19.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "sample-log": "node examples/make-sample-log.ts",
    "anchor": "node --env-file=.env src/cli.ts anchor",
    "verify": "node src/cli.ts verify",
    "demo:tamper": "node src/tamper-demo.ts"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
